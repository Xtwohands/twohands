# Never put provider credentials in VITE_ variables or browser storage.
EXA_API_KEY=
TAVILY_API_KEY=
# Optional page extraction, separate from search
FIRECRAWL_API_KEY=
# Explicit opt-in to the documented, daily-capped free extraction tier. No automatic paid upgrade.
FIRECRAWL_ALLOW_KEYLESS=false
FIRECRAWL_KEYLESS_MAX_REQUESTS=10
# Optional second page reader (Jina Reader), billed by output tokens.
JINA_API_KEY=
# Required when binding beyond loopback. Use a long random value.
API_TOKEN=
HOST=127.0.0.1
PORT=3001
DB_PATH=./data/apilayer.sqlite
# Explicit cutover: adding a URL alone does not switch away from SQLite.
STORAGE_BACKEND=sqlite
# Private server-only Postgres URI. Use direct or Supabase session pooler (5432).
DATABASE_URL=
# Printed by db:inspect and db:import; never claim history for the first signup.
LEGACY_WORKSPACE_ID=
# Explicit Supabase Auth user UUID that will own imported history.
LEGACY_OWNER_USER_ID=
# Public auth settings. VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY aliases also work.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Explicit platform operator UUID allowlist; ordinary workspace owners are not platform admins.
SUPABASE_ADMIN_USER_IDS=
# Configured USD rates for request estimates; account discounts / free credits are not inferred.
# Exa auto base includes up to 10 results; each result above 10 adds this rate.
EXA_SEARCH_USD=0.007
EXA_ADDITIONAL_RESULT_USD=0.001
# Tavily per credit: basic=1, advanced=2.
TAVILY_SEARCH_USD=0.008
FIRECRAWL_SCRAPE_USD=0.001
# Jina Reader per-page estimate; actual usage is reported in output tokens.
JINA_READ_USD=0.0005
PROVIDER_TIMEOUT_MS=20000
PROVIDER_RPM=20
# Backend-managed cap per MCP research session, in USD micro-units ($0.10).
# Consumers and agents do not choose this budget. 0 blocks calls with a positive configured estimate.
AGENT_SESSION_BUDGET_MICROS=100000
# Operator-only controlled provider tests, separate from consumer research.
# Default full suite is 15 calls / $0.080 estimated; no scheduled runs or automatic retries.
PROVIDER_TEST_BUDGET_MICROS=150000
PROVIDER_TEST_DAILY_BUDGET_MICROS=500000
ANALYTICS_MIN_TASKS=5
RETENTION_DAYS=30
# Test USDC deposits on Base Sepolia only. Test credits never fund live provider calls.
# Use a public receiving address you control; no private key is used by octolab.
DEPOSITS_TESTNET_ENABLED=false
BASE_SEPOLIA_DEPOSIT_ADDRESS=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Stripe sandbox only. Keep disabled until test keys and a signed webhook are configured.
STRIPE_TEST_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=http://127.0.0.1:5173

# Separate credential for operator dispute review. Blank disables the admin funding API.
ADMIN_API_TOKEN=

# Optional scoped credential for the MCP bridge; preferred over the workspace owner token.
APILAYER_API_KEY=
