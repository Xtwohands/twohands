{
  "name": "apilayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Intent-aware research routing with auditable provider execution",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --use-env-proxy --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --use-env-proxy --env-file-if-exists=.env build/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "retention": "node --use-env-proxy --env-file-if-exists=.env build/retention.js",
    "format": "prettier --write server src tests *.ts *.json *.html docs README.md",
    "format:check": "prettier --check server src tests *.ts *.json *.html docs README.md",
    "smoke:live": "node --use-env-proxy --env-file-if-exists=.env build/live-validation.js"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
